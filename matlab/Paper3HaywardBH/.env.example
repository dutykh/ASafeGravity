# Telegram Configuration (optional - leave empty to disable notifications)
# Create a bot using @BotFather on Telegram to get these values
BOT_TOKEN=
CHAT_ID=

# Computation Configuration
# List of numerical resolutions to use (comma-separated)
RESOLUTIONS=300,290,280

# Executable Paths
# Path to Maple executable
MAPLE_EXECUTABLE=/path/to/maple

# MATLAB command (can be just 'matlab' if it's in PATH)
MATLAB_EXECUTABLE=matlab

# Timeout Settings (in seconds)
# Maximum time allowed for Maple computation
MAPLE_TIMEOUT=3600

# Maximum time allowed for MATLAB computation (4 hours recommended)
MATLAB_TIMEOUT=14400

# MATLAB Toolbox Paths
# Path to AdvanPix toolbox for multi-precision computing
ADVANPIX_PATH=/path/to/advanpix/

# Parallel Computation Settings
# Enable parallel computation in MATLAB (true/false)
# When true, uses parallel workers to compute multiple resolutions simultaneously
# When false, computes resolutions sequentially with detailed progress updates
MATLAB_PARALLEL=false